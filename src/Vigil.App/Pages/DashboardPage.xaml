<UserControl x:Class="Vigil.App.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Panoramica" Style="{StaticResource H1}" />
        <Border Style="{StaticResource TitleBar}" />

        <!-- Stato principale -->
        <Border x:Name="Hero" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <Grid>
                <Grid.Background>
                    <LinearGradientBrush x:Name="HeroGlow" StartPoint="0,0" EndPoint="1,0.6">
                        <GradientStop x:Name="HeroGlowColor" Color="#3334E0A1" Offset="0" />
                        <GradientStop Color="#00161A2E" Offset="0.6" />
                    </LinearGradientBrush>
                </Grid.Background>
                <!-- Strisce verticali inclinate sul lato destro -->
                <Canvas HorizontalAlignment="Right" Width="300" IsHitTestVisible="False" ClipToBounds="True">
                    <Canvas.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#FF000000" Offset="0.6" />
                        </LinearGradientBrush>
                    </Canvas.OpacityMask>
                    <Rectangle x:Name="Stripe1" Canvas.Left="120" Canvas.Top="-40" Width="22" Height="320" RadiusX="11" RadiusY="11" Opacity="0.55">
                        <Rectangle.RenderTransform><SkewTransform AngleX="-24" /></Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle x:Name="Stripe2" Canvas.Left="170" Canvas.Top="-40" Width="22" Height="320" RadiusX="11" RadiusY="11" Opacity="0.4">
                        <Rectangle.RenderTransform><SkewTransform AngleX="-24" /></Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle x:Name="Stripe3" Canvas.Left="220" Canvas.Top="-40" Width="22" Height="320" RadiusX="11" RadiusY="11" Opacity="0.28">
                        <Rectangle.RenderTransform><SkewTransform AngleX="-24" /></Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle x:Name="Stripe4" Canvas.Left="270" Canvas.Top="-40" Width="22" Height="320" RadiusX="11" RadiusY="11" Opacity="0.18">
                        <Rectangle.RenderTransform><SkewTransform AngleX="-24" /></Rectangle.RenderTransform>
                    </Rectangle>
                </Canvas>
                <Grid Margin="28,26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="86" Height="86" VerticalAlignment="Top">
                        <Ellipse x:Name="HeroRing" StrokeThickness="4" />
                        <Ellipse Margin="8" Fill="{StaticResource Bg2}" />
                        <Path x:Name="HeroIcon" Data="{StaticResource IconShield}" Width="40" Height="40" Stretch="Uniform" StrokeThickness="2" StrokeLineJoin="Round" />
                        <Path x:Name="HeroMark" Data="{StaticResource IconCheck}" Width="14" Height="12" Stretch="Uniform" StrokeThickness="2.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="0,4,0,0" />
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="24,4,0,0">
                        <TextBlock x:Name="HeroTitle" FontFamily="{StaticResource DisplayFont}" FontSize="24" TextWrapping="Wrap" />
                        <TextBlock x:Name="HeroText" Style="{StaticResource Muted}" Margin="0,6,0,18" MaxWidth="520" HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="QuickScanButton" Style="{StaticResource Primary}" Content="Scansione rapida" Click="OnQuickScan" />
                            <Button x:Name="UpdateButton" Style="{StaticResource Ghost}" Content="Aggiorna ora" Margin="10,0,0,0" Click="OnUpdate" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Riquadri -->
        <UniformGrid Columns="3" Margin="0,0,-10,6">
            <Border Style="{StaticResource Tile}">
                <StackPanel>
                    <TextBlock Text="Ultima scansione" Style="{StaticResource Faint}" />
                    <TextBlock x:Name="LastScanValue" FontFamily="{StaticResource DisplayFont}" FontSize="20" Margin="0,4,0,2" />
                    <TextBlock x:Name="LastScanSub" Style="{StaticResource Faint}" />
                    <Border Height="3" CornerRadius="2" Margin="0,10,0,0" Background="{StaticResource GradNeutral}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}">
                <StackPanel>
                    <TextBlock Text="Firme" Style="{StaticResource Faint}" />
                    <TextBlock x:Name="SigValue" FontFamily="{StaticResource DisplayFont}" FontSize="20" Margin="0,4,0,2" />
                    <TextBlock x:Name="SigSub" Style="{StaticResource Faint}" />
                    <Border Height="3" CornerRadius="2" Margin="0,10,0,0" Background="{StaticResource GradOk}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}" Cursor="Hand" MouseLeftButtonUp="OnOpenQuarantine">
                <StackPanel>
                    <TextBlock Text="In quarantena" Style="{StaticResource Faint}" />
                    <TextBlock x:Name="QuarValue" FontFamily="{StaticResource DisplayFont}" FontSize="20" Margin="0,4,0,2" />
                    <TextBlock x:Name="QuarSub" Style="{StaticResource Faint}" />
                    <Border Height="3" CornerRadius="2" Margin="0,10,0,0" Background="{StaticResource GradDanger}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Motori -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Motori di protezione" Style="{StaticResource H2}" Margin="0,0,0,12" />
                <StackPanel x:Name="Engines" />
            </StackPanel>
        </Border>

        <!-- Aggiornamenti -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Aggiornamenti" Style="{StaticResource H2}" />
                <TextBlock x:Name="UpdateInfo" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                <Border x:Name="LogBox" Background="{StaticResource Bg2}" CornerRadius="10" Padding="12,10" Margin="0,12,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="LogText" FontFamily="Consolas, Lucida Console, Courier New" FontSize="12" Foreground="{StaticResource Text2}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
