<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Vigil Legacy: tema "neon stripes" come Vigil.
      Base inchiostro profondo, strisce viola/ciano/lime, colori di stato a gradiente.
      Niente effetti costosi (sfocature, ombre): su XP WPF disegna tutto via software.
    -->
    <Color x:Key="BgColor">#0A0B14</Color>
    <Color x:Key="VioletColor">#8B5CF6</Color>
    <Color x:Key="MagentaColor">#E04FD8</Color>
    <Color x:Key="CyanColor">#22D3EE</Color>
    <Color x:Key="TealColor">#2DD4BF</Color>
    <Color x:Key="LimeColor">#A3E635</Color>
    <Color x:Key="AmberColor">#FBBF24</Color>
    <Color x:Key="OrangeColor">#FB7C3C</Color>
    <Color x:Key="RoseColor">#FB4B6E</Color>
    <Color x:Key="OkColor">#34E0A1</Color>

    <SolidColorBrush x:Key="Bg" Color="#0A0B14" />
    <SolidColorBrush x:Key="Bg2" Color="#0E1020" />
    <SolidColorBrush x:Key="Surface" Color="#161A2E" />
    <SolidColorBrush x:Key="Surface2" Color="#1C2038" />
    <SolidColorBrush x:Key="Surface3" Color="#252A46" />
    <SolidColorBrush x:Key="Border" Color="#262B45" />
    <SolidColorBrush x:Key="BorderStrong" Color="#3A4066" />
    <SolidColorBrush x:Key="Text" Color="#EEF0FB" />
    <SolidColorBrush x:Key="Text2" Color="#A4A9C8" />
    <SolidColorBrush x:Key="Text3" Color="#6C7194" />
    <SolidColorBrush x:Key="Violet" Color="{StaticResource VioletColor}" />
    <SolidColorBrush x:Key="Cyan" Color="{StaticResource CyanColor}" />
    <SolidColorBrush x:Key="Lime" Color="{StaticResource LimeColor}" />
    <SolidColorBrush x:Key="Amber" Color="{StaticResource AmberColor}" />
    <SolidColorBrush x:Key="Rose" Color="{StaticResource RoseColor}" />
    <SolidColorBrush x:Key="Ok" Color="{StaticResource OkColor}" />

    <LinearGradientBrush x:Key="GradBrand" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource VioletColor}" Offset="0" />
        <GradientStop Color="{StaticResource CyanColor}" Offset="0.55" />
        <GradientStop Color="{StaticResource LimeColor}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GradNeutral" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource VioletColor}" Offset="0" />
        <GradientStop Color="{StaticResource CyanColor}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GradOk" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource TealColor}" Offset="0" />
        <GradientStop Color="{StaticResource LimeColor}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GradWarn" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource AmberColor}" Offset="0" />
        <GradientStop Color="{StaticResource OrangeColor}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GradDanger" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource RoseColor}" Offset="0" />
        <GradientStop Color="{StaticResource MagentaColor}" Offset="1" />
    </LinearGradientBrush>

    <!-- Icone (stile a tratto, riquadro 24x24). -->
    <Geometry x:Key="IconHome">M3,11 L12,3.5 L21,11 M5.5,9.5 V20.5 H18.5 V9.5 M10,20.5 V14.5 H14 V20.5</Geometry>
    <Geometry x:Key="IconScan">M3,8 V3 H8 M16,3 H21 V8 M21,16 V21 H16 M8,21 H3 V16 M7,12 H17</Geometry>
    <Geometry x:Key="IconBox">M12,2.5 L20.5,7 V17 L12,21.5 L3.5,17 V7 Z M3.5,7 L12,11.5 L20.5,7 M12,11.5 V21.5</Geometry>
    <Geometry x:Key="IconSettings">M4,7 H11 M17,7 H20 M4,17 H7 M13,17 H20 M14,4 V10 M10,14 V20</Geometry>
    <Geometry x:Key="IconShield">M12,2.5 L19.5,5.5 V11 C19.5,15.8 16.3,19.6 12,21.5 C7.7,19.6 4.5,15.8 4.5,11 V5.5 Z</Geometry>
    <Geometry x:Key="IconCheck">M8,12.5 L11,15.5 L16.5,9.5</Geometry>
    <Geometry x:Key="IconAlert">M12,3.5 L21.5,20 H2.5 Z M12,9.5 V14 M12,17 V17.1</Geometry>
    <Geometry x:Key="IconFolder">M3,6.5 C3,5.7 3.7,5 4.5,5 H9.5 L11.5,7 H19.5 C20.3,7 21,7.7 21,8.5 V18 C21,18.8 20.3,19.5 19.5,19.5 H4.5 C3.7,19.5 3,18.8 3,18 Z</Geometry>
    <Geometry x:Key="IconBolt">M13,2.5 L5,13.5 H11.5 L10.5,21.5 L19,10 H12.5 Z</Geometry>
    <Geometry x:Key="IconDrive">M3,13 L5.5,5 H18.5 L21,13 V18.5 H3 Z M3,13 H21 M16.5,16 H16.6</Geometry>
    <Geometry x:Key="IconRefresh">M20,11 A8,8 0 0 0 5.5,6.5 L4,8 M4,3.5 V8 H8.5 M4,13 A8,8 0 0 0 18.5,17.5 L20,16 M20,20.5 V16 H15.5</Geometry>

    <FontFamily x:Key="UiFont">Segoe UI, Tahoma, Verdana</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Semibold, Segoe UI, Tahoma</FontFamily>

    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <Style x:Key="H1" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style x:Key="H2" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style x:Key="Muted" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource Text2}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Faint" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource Text3}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Sottolineatura a gradiente sotto i titoli delle pagine. -->
    <Style x:Key="TitleBar" TargetType="{x:Type Border}">
        <Setter Property="Height" Value="4" />
        <Setter Property="Width" Value="64" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="0,8,0,22" />
        <Setter Property="Background" Value="{StaticResource GradBrand}" />
    </Style>

    <Style x:Key="Card" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="22" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style x:Key="Tile" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource Surface2}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Margin" Value="0,0,10,10" />
    </Style>

    <!-- Pulsanti -->
    <Style x:Key="ButtonBase" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="{StaticResource Surface3}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Opacity" Value="0.7" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="{x:Type Button}" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#7C4DF0" Offset="0" />
                    <GradientStop Color="#1BA9C9" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style x:Key="Ghost" TargetType="{x:Type Button}" BasedOn="{StaticResource ButtonBase}" />
    <Style x:Key="Danger" TargetType="{x:Type Button}" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{StaticResource GradDanger}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style x:Key="Small" TargetType="{x:Type Button}" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

    <!-- Voci della barra laterale -->
    <Style x:Key="Nav" TargetType="{x:Type RadioButton}">
        <Setter Property="Foreground" Value="{StaticResource Text2}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="GroupName" Value="nav" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Margin" Value="12,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Grid>
                        <Border x:Name="bg" CornerRadius="10" Background="Transparent" />
                        <Border x:Name="bar" Width="3" CornerRadius="2" HorizontalAlignment="Left" Margin="-12,8,0,8"
                                Background="{StaticResource GradBrand}" Visibility="Hidden" />
                        <StackPanel Orientation="Horizontal" Margin="12,9">
                            <Path x:Name="icon" Data="{TemplateBinding Tag}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="20" Height="20" Stretch="Uniform" />
                            <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{StaticResource Surface2}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{StaticResource Surface3}" />
                            <Setter TargetName="bar" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Scelte a "pillola" (es. intervallo di aggiornamento) -->
    <Style x:Key="Chip" TargetType="{x:Type RadioButton}">
        <Setter Property="Foreground" Value="{StaticResource Text2}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Border x:Name="b" CornerRadius="14" Padding="14,5" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource GradNeutral}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Interruttore on/off: Content = titolo, Tag = descrizione -->
    <Style x:Key="Toggle" TargetType="{x:Type CheckBox}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Margin" Value="0,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <ContentPresenter />
                            <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource Faint}" Margin="0,2,0,0" FontSize="12.5" />
                        </StackPanel>
                        <Border x:Name="track" Grid.Column="1" Width="44" Height="24" CornerRadius="12" Background="{StaticResource Surface3}"
                                BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" VerticalAlignment="Center">
                            <Ellipse x:Name="thumb" Width="16" Height="16" Fill="{StaticResource Text2}" HorizontalAlignment="Left" Margin="3,0" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{StaticResource GradNeutral}" />
                            <Setter TargetName="track" Property="BorderThickness" Value="0" />
                            <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="thumb" Property="Fill" Value="White" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{StaticResource Bg2}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="CaretBrush" Value="{StaticResource Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Barra di scorrimento sottile (quella di Luna su XP stonerebbe col tema scuro). -->
    <Style x:Key="ThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border CornerRadius="4" Background="{StaticResource Surface3}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ThumbStyle}" />
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="8" />
                <Setter Property="MinHeight" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ThumbStyle}" />
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="Background" Value="{StaticResource Surface3}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
    </Style>
</ResourceDictionary>
