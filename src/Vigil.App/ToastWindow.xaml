<Window x:Class="Vigil.App.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        SizeToContent="Height" Width="380" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1"
        FontFamily="{StaticResource UiFont}" FontSize="13.5" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <!-- Niente AllowsTransparency: le finestre stratificate su XP sono lente. Angoli vivi, ma leggera. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border x:Name="Accent" Background="{StaticResource GradDanger}" />
        <StackPanel Grid.Column="1" Margin="16,14,14,14">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Image Source="Assets/logo.png" Width="18" Height="18" />
                    <TextBlock Text="Vigil Legacy" Style="{StaticResource Faint}" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button HorizontalAlignment="Right" Style="{StaticResource Small}" Padding="7,5" Click="OnClose" ToolTip="Chiudi">
                    <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="{StaticResource Text2}" StrokeThickness="1.5" Width="8" Height="8" />
                </Button>
            </Grid>
            <TextBlock x:Name="TitleText" FontFamily="{StaticResource DisplayFont}" FontSize="16" Margin="0,10,0,4" TextWrapping="Wrap" />
            <TextBlock x:Name="BodyText" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" MaxHeight="60" />
            <WrapPanel x:Name="Actions" Margin="0,12,0,0" />
        </StackPanel>
    </Grid>
</Window>
