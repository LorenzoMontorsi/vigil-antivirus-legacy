<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net40</TargetFramework>
    <RootNamespace>Vigil.Engine</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Core" />
  </ItemGroup>
  <ItemGroup>
    <!-- TLS 1.2/1.3 su XP, dove SChannel si ferma a TLS 1.0 (licenza MIT). -->
    <PackageReference Include="Portable.BouncyCastle" Version="1.9.0" />
    <!-- Radici fidate di Mozilla, da https://curl.se/ca/cacert.pem (MPL 2.0). -->
    <EmbeddedResource Include="Resources\cacert.pem" LogicalName="Vigil.Engine.Resources.cacert.pem" />
  </ItemGroup>
</Project>
